# ─────────────────────────────────────────────────────────────────────────────
# Ponte de avisos Leadframe — copie para .env e preencha NA VPS.
# O .env nunca vai para o Git, para o chat nem para o segundo cérebro.
# ─────────────────────────────────────────────────────────────────────────────

# "teste" = lê, monta e registra, mas NÃO envia (padrão). "envio" = manda de verdade.
PONTE_MODO=teste

# Aviso de reunião marcada pela IA (modelo aviso_reuniao_marcada). "ligado" só
# depois que a Meta aprovar o modelo; antes disso, cada aviso vira erro 132001.
PONTE_REUNIOES=desligado

# Organização da Leadframe no Deskcomm (select id, name from public.organizations;)
PONTE_ORG_ID=

# Conexão do papel dedicado, pelo pooler do Supabase (Settings › Database › Connection string,
# modo "Session"). Usuário no formato leadframe_ponte_leitor.<ref-do-projeto>.
# Senha com caractere especial precisa ir codificada (ex.: @ vira %40). Não ponha sslmode aqui.
PONTE_DB_URL=postgresql://leadframe_ponte_leitor.<ref>:<senha>@<host-do-pooler>:5432/postgres
# verificar | sem_verificar | desligado. O pooler do Supabase usa certificado da própria Supabase
# (não reconhecido pelo sistema): sem o arquivo abaixo, "verificar" recusa a conexão.
# Raiz "Supabase Root 2021 CA" (sha256 80:70:25:AD:…:CA:FA, vence 2031), baixada de
# supabase-downloads.s3-ap-southeast-1.amazonaws.com/prod/ssl/prod-ca-2021.crt e conferida
# contra a cadeia do pooler em 2026-10-05. Fica em ./certs/supabase-ca.crt na VPS.
PONTE_DB_SSL=verificar
PONTE_DB_CA_ARQUIVO=/app/certs/supabase-ca.crt

# WhatsApp oficial (Cloud API). ID do número +55 00 9000-0002, lido em Deskcomm › Conexões ›
# API Oficial (Meta) em 2026-10-05 (WABA 100000000000001). Não é segredo.
META_GRAPH_VERSION=v23.0
META_PHONE_NUMBER_ID=100000000000002
# Token gerado para a ponte (no "Conversions API System User", que já serve o WhatsApp
# oficial), só com whatsapp_business_messaging.
META_TOKEN=

# Quem recebe os avisos (Bruno).
AVISO_DESTINO=+5500999990001

# Ajustes (os valores abaixo são os padrões)
PONTE_INTERVALO_S=30
PONTE_IDADE_MAXIMA_MIN=60
PONTE_REAVISO_MESMA_CONVERSA_MIN=30
PONTE_MAX_TENTATIVAS=5
PONTE_ESPACAMENTO_S=7
PONTE_DIR_ESTADO=/data
